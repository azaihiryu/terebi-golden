<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FILE VERIFICATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1F25"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📂 PS Vita P4G Directory Scanner"
                    android:textColor="#FFD000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFileScannerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scanning game files..."
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tvCheckEboot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[ ] eboot.bin / executable"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCheckData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[ ] data/ directory assets"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvCheckSceSys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[ ] sce_sys/ (param.sfo &amp; icons)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRescanDirectory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Re-Scan Directory Integrity"
                    android:textColor="#FFD000"
                    app:strokeColor="#FFD000"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CHEATS & MOD LOADER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E1F25"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧩 Patches &amp; Mod Enhancements"
                    android:textColor="#FFD000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• HD UI &amp; Persona Texture Pack (Active)"
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Japanese Japanese Dual-Audio Undub Patch (Active)"
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• High Quality Audio BGM Uncompressed"
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
