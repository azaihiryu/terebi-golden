<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOUCH OVERLAY SETTINGS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1F25"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 On-Screen Touch Controls"
                    android:textColor="#FFD000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTouchOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enable Touch Controls Overlay"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:thumbTint="#FFD000"
                    app:trackTint="#66FFD000" />

                <TextView
                    android:id="@+id/tvOpacityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Button Opacity: 80%"
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="80"
                    app:thumbColor="#FFD000"
                    app:trackColorActive="#FFD000"
                    app:trackColorInactive="#282932" />

                <TextView
                    android:id="@+id/tvScaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Button Size / Scale: 100%"
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="50"
                    android:valueTo="150"
                    android:value="100"
                    app:thumbColor="#FFD000"
                    app:trackColorActive="#FFD000"
                    app:trackColorInactive="#282932" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHaptic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Haptic Vibration Feedback"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:thumbTint="#FFD000"
                    app:trackTint="#66FFD000" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- EXTERNAL CONTROLLER MAPPING CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E1F25"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 External Controller Mapping"
                    android:textColor="#FFD000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGamepadStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Detecting Gamepad / Bluetooth Controller..."
                    android:textColor="#B0B3C6"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapGamepad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Configure Key Mappings"
                    android:textColor="#121214"
                    android:textStyle="bold"
                    app:backgroundTint="#FFD000"
                    app:cornerRadius="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Mappings:"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvMappingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• D-Pad: Standard Axis/DPad\n• △: Button Y / North\n• ○: Button B / East\n• ✕: Button A / South\n• □: Button X / West\n• L / R: Shoulder L1 / R1"
                    android:textColor="#B0B3C6"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
